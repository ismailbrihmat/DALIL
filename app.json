{
  "expo": {
    "name": "Dalil Morocco",
    "slug": "dalil-morocco",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.dalilmorocco",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Dalil to use the microphone for voice input.",
        "NSSpeechRecognitionUsageDescription": "Allow Dalil to use speech recognition to understand your voice commands."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.dalilmorocco",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Dalil to use the microphone for voice input.",
          "speechRecognitionPermission": "Allow Dalil to use speech recognition to understand your voice commands.",
          "androidRecognitionService": {
            "packageName": "com.google.android.googlequicksearchbox",
            "action": "android.speech.RecognitionService"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ee9cf9a5-79f9-4e72-a67e-7193ed869388"
      }
    }
  }
}
